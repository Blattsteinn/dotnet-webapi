@host = http://localhost:5258
@placeId =7783

### Get all places (admin)
GET {{host}}/api/v1/admin/places
Accept: application/json

### Get place by id (admin, fully nested, hidden included)
GET {{host}}/api/v1/admin/places/{{placeId}}
Accept: application/json

### PATCH place — valid (this one should return 200)
PATCH {{host}}/api/v1/admin/places/{{placeId}}
Content-Type: application/json

{
  "name": "Pizza Palace v1",
  "latitude": 0.7128,
  "longtitude": -74.0060,
  "description": "Updated description",
  "productCategories": [
    {
      "id": 29,
      "Destroy": true,
      "name": "Pizzas",
      "description": null,
      "hidden": false,
      "products": []
    }
  ]
}


###

POST {{host}}/api/v1/places
Content-Type: application/json

{
    "latitude": 50.44,
    "longtitude": 50.44,
    "name": "Unique shooper",
    "description": "Oooga booga"
}