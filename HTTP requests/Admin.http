@host = http://localhost:5258
@placeId =7786

@auth_token = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..sIz2qdvJUy_0xsztbQpk0sjMDembnc6ORQnuoH2tEk4


### Get all places (admin)
GET {{host}}/api/v1/admin/places
Accept: application/json
Authorization: Bearer {{auth_token}}

### Get place by id (admin, fully nested, hidden included)
GET {{host}}/api/v1/admin/places/{{placeId}}
Authorization: Bearer {{auth_token}}
Accept: application/json

### PATCH place visibility — the admin's place-level control
# Admin no longer edits place content; that is the owner's PATCH /api/v1/owner/places/{id}.
# This is what the admin uses to hide / re-publish a place, including recovering one
# that was auto-hidden when its owner was demoted.
PATCH {{host}}/api/v1/admin/places/{{placeId}}/visibility
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "hidden": true
}

### POST
POST {{host}}/api/v1/admin/places
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
    "latitude": 50.44,
    "longtitude": 50.44,
    "name": "Unique shooper",
    "description": "Oooga booga"
}

### Delete a place
DELETE {{host}}/api/v1/admin/places/{{placeId}}
Authorization: Bearer {{auth_token}}
Accept: application/json