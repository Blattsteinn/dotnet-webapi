@FoodOrderingApi_HostAddress = http://localhost:5258
@placeId = 1
@orderId = 4262

# Paste a customer's token from POST /api/v1/auth/login.
@token = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..-D2OyIVyBfjFPqoXUitTkBpDJHpnllUTu1oVjJq7B04
###
# My orders — customer scope. Returns only the caller's own orders, so this
# needs a token (it used to be an unauthenticated "every order in the system").
GET {{FoodOrderingApi_HostAddress}}/api/v1/orders
Authorization: Bearer {{token}}
Accept: application/json

###

# One of my orders
GET {{FoodOrderingApi_HostAddress}}/api/v1/orders/{{orderId}}
Authorization: Bearer {{token}}
Accept: application/json

###

# Create an order — required add-on missing. Product 1 (Margherita) has a
# required "Crust Type" add-on category (add-ons 4/5/6). Add-ons 2 and 3 belong
# to the optional "Extra Toppings" category, so no required category is
# covered and this returns 400 RequiredAddOnsNotSpecified.
POST {{FoodOrderingApi_HostAddress}}/api/v1/orders
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "placeId": {{placeId}},
    "orderItems": [
        {
            "productId": 1,
            "quantity": 5,
            "addOns": [
                {
                    "addOnId": 2,
                    "quantity": 5
                },
                {
                    "addOnId": 3,
                    "quantity": 1
                }
            ]
        }
    ]

}

###
# Create an order — required add-on satisfied. Add-on 4 (Regular) is in the
# required "Crust Type" category, so this returns 200. Swap 4 for 5 (Thin) or
# 6 (Thick) for other crusts; drop it to get the 400 from the request above.
POST {{FoodOrderingApi_HostAddress}}/api/v1/orders
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "placeId": {{placeId}},
    "orderItems": [
        {
            "productId": 1,
            "quantity": 5,
            "addOns": [
                {
                    "addOnId": 4,
                    "quantity": 1
                }
            ]
        }
    ]

}

###
# Create an order — single-choice category violated. "Crust Type" is
# Multichoice = false, so picking add-ons 4 (Regular) and 5 (Thin) at once
# returns 400 SingleChoiceAddOnsExceeded. "Extra Toppings" is Multichoice =
# true, so combining 2 and 3 there is fine.
POST {{FoodOrderingApi_HostAddress}}/api/v1/orders
Authorization: ******
Content-Type: application/json

{
    "placeId": {{placeId}},
    "orderItems": [
        {
            "productId": 1,
            "quantity": 1,
            "addOns": [
                {
                    "addOnId": 4,
                    "quantity": 1
                },
                {
                    "addOnId": 5,
                    "quantity": 1
                }
            ]
        }
    ]

}

# Changing a status is no longer a customer action — it is manager-scoped:
#   PATCH /api/v1/manager/places/{placeId}/orders/{orderId}/status
# The owner of the place counts as a manager, so both owners and the users the
# owner added to the place's Managers table can call it.
# OrderStatus: 0 = Pending, 1 = Confirmed, 2 = Preparing, 3 = Ready, 4 = Completed, 5 = Cancelled
