@FoodOrderingApi_HostAddress = http://localhost:5258
@orderItemId = 1
@orderItemAddOnId = 1

# Get all add-ons of an order item
GET {{FoodOrderingApi_HostAddress}}/api/v1/order-items/{{orderItemId}}/add-ons
Accept: application/json

###

# Get an order item add-on by id
GET {{FoodOrderingApi_HostAddress}}/api/v1/order-items/{{orderItemId}}/add-ons/{{orderItemAddOnId}}
Accept: application/json

###
