# Where the frontend reaches the FoodOrderingApi. This is the single place the
# API location is configured — never hard-code it elsewhere in the app.
#
# Development: leave VITE_API_URL empty. Requests then go to the dev server's own
# origin (/api/v1/...) and Vite proxies them to the API (VITE_API_PROXY_TARGET
# below). Proxying keeps the ASP.NET development certificate out of the browser's
# trust store, so there is no ERR_CERT_AUTHORITY_INVALID and no cross-origin
# request to preflight.
#
# Deployed: set this to the API's public origin, e.g.
#   VITE_API_URL=https://api.example.com
VITE_API_URL=

# Target of the dev-server proxy for /api requests. This is the https:// URL from
# FoodOrderingApi/Properties/launchSettings.json — never the http:// one, which
# only redirects to https and would add a hop for every call. The proxy accepts
# the development certificate itself (server.secure = false), so the browser
# never has to.
VITE_API_PROXY_TARGET=https://localhost:7039
